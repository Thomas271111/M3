# Copia este archivo como .env y completa los valores. NUNCA subas .env al repositorio.
PORT=4000

# Cadena de conexión de MongoDB Atlas (Database > Connect > Drivers). Incluye el nombre de la base: /mihato
MONGODB_URI=mongodb+srv://USUARIO:CLAVE@CLUSTER.mongodb.net/mihato?retryWrites=true&w=majority

# Cadena larga y aleatoria (mínimo 16 caracteres). Generar una:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES_IN=7d

# Origen(es) del cliente permitidos por CORS, separados por coma. En producción: la URL de Vercel del cliente.
CLIENT_URL=http://localhost:5173

# Opcional, solo desarrollo local: si Node falla con "querySrv ECONNREFUSED" al conectar a Atlas,
# fuerza un DNS que soporte registros SRV.
# DNS_SERVERS=8.8.8.8,1.1.1.1
